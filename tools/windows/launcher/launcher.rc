#include <winver.h>
1 ICON "totk.ico"
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MacNativeGames"
      VALUE "FileDescription", "Tears of the Kingdom launcher"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "totk-launcher"
      VALUE "OriginalFilename", "Tears of the Kingdom.exe"
      VALUE "ProductName", "Tears of the Kingdom (native Windows port)"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
